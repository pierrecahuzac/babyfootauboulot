{
  "name": "babyfoot-api",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/utils",
    "test:integration": "vitest run tests/integration",
    "test:integration:real": "vitest run tests/integration/app.real.integration.test.js",
    "test:integration:mock": "vitest run tests/integration/app.integration.test.js",
    "test:e2e": "RUN_E2E=1 vitest run tests/e2e",
    "test:db:setup": "node -e \"import pg from 'pg'; const p=new pg.Pool({connectionString: process.env.DATABASE_URL_TEST || 'postgres://babyfoot:babyfoot@localhost:5432/postgres'}); p.query('CREATE DATABASE babyfoot_test').then(()=>console.log('test DB créée')).catch(e=>console.log(e.message)).finally(()=>p.end())\"",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "node src/db/seed.js",
    "db:seed:clean": "node src/db/seed.js --clean",
    "db:seed:demo": "node src/db/seed.js --demo",
    "db:seed:demo:clean": "node src/db/seed.js --demo --clean",
    "db:studio": "drizzle-kit studio --host 0.0.0.0 --port 4983 --verbose",
    "db:studio:host": "sh -c 'DATABASE_URL=$(echo ${DATABASE_URL:-postgres://babyfoot:babyfoot@db:5432/babyfoot} | sed s/@db:/@localhost:/) drizzle-kit studio --host 127.0.0.1 --port 4983 --verbose'"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.0",
    "vitest": "^3.2.7"
  }
}
