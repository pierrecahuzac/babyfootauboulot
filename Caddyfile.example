# À ajouter à ton Caddy existant (déjà en place sur le serveur)
# Hypothèse : Caddy est hors docker-compose mais sur le même host
# Landing Astro (55175) + App Vite (55174) + API Fastify (33333)

# Vitrine publique — Astro
babyfootauboulot.dev {
  reverse_proxy localhost:55175
  encode gzip
}

# App — React + API
app.babyfootauboulot.dev {
  # API -> Fastify (doit être AVANT le catch-all handle)
  handle /api/* {
    reverse_proxy localhost:33333
  }
  # App Vite (ou dist buildé) — catch-all
  handle {
    reverse_proxy localhost:55174
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
  encode gzip
}

