# Copie ce fichier en .env et ajuste les valeurs
# Ne commit JAMAIS ton .env réel

# ── DB Neon (prod) ou local Docker ──
# Local Docker:
# DATABASE_URL=postgres://babyfoot:change-moi-en-prod@db:5432/babyfoot
# DATABASE_URL_TEST=postgres://babyfoot:change-moi-en-prod@db:5432/babyfoot_test
# Neon prod (comme vinyls: pooler eu-west-2 + sslmode + channel_binding):
# DATABASE_URL=postgresql://neondb_owner:npg_xxx@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
POSTGRES_DB=babyfoot
POSTGRES_USER=babyfoot
POSTGRES_PASSWORD=change-moi-en-prod
DATABASE_URL=postgres://babyfoot:change-moi-en-prod@db:5432/babyfoot
DATABASE_URL_TEST=postgres://babyfoot:change-moi-en-prod@db:5432/babyfoot_test

# API (Render: envVars dans render.yaml)
PORT=33333
JWT_SECRET=change-moi-en-prod-32-chars-minimum
# Optionnel : durée JWT
# JWT_EXPIRES=7d
# Admin (emails séparés par , — ces comptes auront role admin au boot)
# ADMIN_EMAILS=admin@example.com
# CORS (prod) — Vercel + Render
# Prod Vercel: app + landing (voir https://app.babyfootauboulot.vercel.app + https://babyfootauboutot.vercel.app)
# CORS_ORIGIN=https://app.babyfootauboulot.vercel.app,https://babyfootauboulot.vercel.app,https://babyfootauboutot.vercel.app
CORS_ORIGIN=https://app.babyfootauboulot.vercel.app,https://babyfootauboulot.vercel.app,https://babyfootauboutot.vercel.app,http://localhost:55174,http://localhost:55175

# Web (Vite) — laisser vide pour proxy relatif /api → api:33333 (recommandé local + LAN)
VITE_API_URL=
# Prod Vercel: VITE_API_URL=https://babyfootauboulot.onrender.com

# Landing (Astro)
PUBLIC_APP_URL=http://localhost:55174
# Prod Vercel: PUBLIC_APP_URL=https://app.babyfootauboulot.vercel.app

# Ports exposés (si tu veux changer)
# WEB_PORT=55174
# LANDING_PORT=55175
# API_PORT=33333
# STUDIO_PORT=4983

# ── Drizzle Studio — DEV SEULEMENT, INTERDIT en prod !!! ──
# Studio expose toute la DB sans auth. Ne jamais activer en prod.
# Drizzle Kit 0.30+ -> https://local.drizzle.studio (pas http://localhost:4983, 404 normal)
# Lancement: docker compose --profile dev up studio  -> https://local.drizzle.studio
# ou host: cd api && npm run db:studio:host

# ── Déploiement prod Vercel + Render + Neon (auto-deploy sur push main) ──
# 1. Neon: nouveau projet babyfootauboulot → copier DATABASE_URL pooler (ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require) → local: DATABASE_URL=<neon> npm run db:push --prefix api && npm run db:seed --prefix api
# 2. Render: dashboard.render.com → New Web Service → connecte pierrecahuzac/babyfootauboulot → détecte render.yaml (rootDir api, plan free) → env DATABASE_URL, JWT_SECRET, CORS_ORIGIN, ADMIN_EMAILS → URL https://babyfootauboulot.onrender.com (voir render.yaml)
# 3. Vercel: 2 projets app.babyfootauboulot (web) + babyfootauboulot (landing) → env VITE_API_URL=https://babyfootauboulot.onrender.com, PUBLIC_APP_URL=https://app.babyfootauboulot.vercel.app → auto-deploy sur push main
