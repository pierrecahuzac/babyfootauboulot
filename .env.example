# Copie ce fichier en .env et ajuste les valeurs
# Ne commit JAMAIS ton .env réel

# ── DB Neon (prod) ou local Docker ──
# Local Docker:
# DATABASE_URL=postgres://babyfoot:change-moi-en-prod@db:5432/babyfoot
# DATABASE_URL_TEST=postgres://babyfoot:change-moi-en-prod@db:5432/babyfoot_test
# Neon prod (avec pooler + sslmode):
# DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/babyfoot?sslmode=require
# DATABASE_URL_TEST=postgres://user:password@ep-xxx.neon.tech/babyfoot_test?sslmode=require
POSTGRES_DB=babyfoot
POSTGRES_USER=babyfoot
POSTGRES_PASSWORD=change-moi-en-prod
DATABASE_URL=postgres://babyfoot:change-moi-en-prod@db:5432/babyfoot
DATABASE_URL_TEST=postgres://babyfoot:change-moi-en-prod@db:5432/babyfoot_test

# API (Render: envVars dans render.yaml)
PORT=33333
JWT_SECRET=change-moi-en-prod-32-chars-minimum
# Optionnel : durée JWT
# JWT_EXPIRES=7d
# Admin (emails séparés par , — ces comptes auront role admin au boot)
# ADMIN_EMAILS=admin@example.com
# CORS (prod) — Vercel babyfootauboulot
# CORS_ORIGIN=https://babyfootauboulot.vercel.app,https://babyfootauboulot-landing.vercel.app
CORS_ORIGIN=https://babyfootauboulot.vercel.app,https://babyfootauboulot-landing.vercel.app,http://localhost:55174,http://localhost:55175

# Web (Vite) — laisser vide pour proxy relatif /api → api:33333 (recommandé local + LAN)
VITE_API_URL=
# Prod Vercel: VITE_API_URL=https://babyfootauboulot-api.onrender.com

# Landing (Astro)
PUBLIC_APP_URL=http://localhost:55174
# Prod Vercel: PUBLIC_APP_URL=https://babyfootauboulot.vercel.app

# Ports exposés (si tu veux changer)
# WEB_PORT=55174
# LANDING_PORT=55175
# API_PORT=33333
# STUDIO_PORT=4983

# ── Drizzle Studio — DEV SEULEMENT, INTERDIT en prod !!! ──
# Studio expose toute la DB sans auth. Ne jamais activer en prod.
# Drizzle Kit 0.30+ -> https://local.drizzle.studio (pas http://localhost:4983, 404 normal)
# Lancement: docker compose --profile dev up studio  -> https://local.drizzle.studio
# ou host: cd api && npm run db:studio:host

# ── Déploiement prod Vercel + Render + Neon (auto-deploy sur push main) ──
# 1. Neon: créer projet → copier DATABASE_URL (avec ?sslmode=require) → local: DATABASE_URL=<neon> npm run db:push --prefix api && npm run db:seed --prefix api
# 2. Render: New Web Service babyfootauboulot-api → rootDir api → build npm ci --omit=dev → start npm start → env NODE_ENV=production, DATABASE_URL, JWT_SECRET, CORS_ORIGIN=https://babyfootauboulot.vercel.app,https://babyfootauboulot-landing.vercel.app, ADMIN_EMAILS → auto-deploy sur push main
# 3. Vercel: 2 projets babyfootauboulot (web) + babyfootauboulot-landing → env VITE_API_URL=https://babyfootauboulot-api.onrender.com, PUBLIC_APP_URL=https://babyfootauboulot.vercel.app → auto-deploy sur push main
