# Copie ce fichier en .env et ajuste les valeurs
# Ne commit JAMAIS ton .env réel

# DB
POSTGRES_DB=babyfoot
POSTGRES_USER=babyfoot
POSTGRES_PASSWORD=change-moi-en-prod
DATABASE_URL=postgres://babyfoot:change-moi-en-prod@db:5432/babyfoot
DATABASE_URL_TEST=postgres://babyfoot:change-moi-en-prod@db:5432/babyfoot_test
# Pour run host (npm test) le helper tente localhost puis db automatiquement

# API
PORT=33333
JWT_SECRET=change-moi-en-prod-32-chars-minimum
# Optionnel : durée JWT
# JWT_EXPIRES=7d

# Web (Vite) — laisser vide pour proxy relatif /api → api:33333 (recommandé local + LAN)
VITE_API_URL=
# Prod: VITE_API_URL=https://app.babyfootauboulot.dev

# Landing (Astro)
PUBLIC_APP_URL=http://localhost:55174
# Prod: PUBLIC_APP_URL=https://app.babyfootauboulot.dev

# Ports exposés (si tu veux changer)
# WEB_PORT=55174
# LANDING_PORT=55175
# API_PORT=33333
